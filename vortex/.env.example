# Database Configuration
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# PUT TEST KEYS HERE
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Live Keys (used by Payment.php when is_test_mode = 0)
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Application Environment
APP_ENV=production
APP_URL=https://icswhmh.com

# Google Accounts SMTP Mailer
# NOTE: For Gmail, use a 16-character Google App Password (not your personal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME="PayVortex Gateway"

# SMS Gateway Configuration (mock, twilio, fast2sms)
SMS_DRIVER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
